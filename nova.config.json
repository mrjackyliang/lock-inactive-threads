{
  "project": {
    "name": {
      "title": "Lock Inactive Threads",
      "slug": "lock-inactive-threads"
    },
    "description": {
      "short": "A GitHub Action designed to lock issues and pull requests that have been inactive for a configurable number of days",
      "long": "GitHub Action that locks closed issues and pull requests once they have gone quiet for a configurable number of days. Issues and pull requests each get their own inactivity window, comment text, and GitHub lock reason. Excluded labels are skipped, and a dry run lists every thread it would lock \u2014 number, title, and last activity \u2014 before anything changes."
    },
    "keywords": [
      "actions",
      "github-actions",
      "lock-threads",
      "inactive-issues",
      "stale"
    ],
    "legalName": "Jacky Liang",
    "pronouns": "personal",
    "platforms": [
      "nodejs"
    ],
    "startingYear": 2026,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "author"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@mrjackyliang.com"
  },
  "github": {
    "owner": "mrjackyliang",
    "repo": "lock-inactive-threads",
    "topics": [
      "actions",
      "github-actions",
      "stale",
      "inactive-issues",
      "lock-threads"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": false
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 90
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ]
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ]
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ]
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "build": [
        "./packages/lock-inactive-threads",
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "github-action",
          "path": "./packages/lock-inactive-threads"
        },
        {
          "to": "github-pages-docusaurus",
          "path": "./apps/docs"
        }
      ],
      "with": {
        "ACTION_ENTRY_POINT": "index.js",
        "ACTION_OUTPUT_PATH": "./packages/lock-inactive-threads/build",
        "ACTION_YML_PATH": "./action.yml",
        "RELEASE_BRANCH_NAME": "releases"
      }
    }
  ],
  "urls": {
    "homepage": "https://mrjackyliang.github.io/lock-inactive-threads/",
    "repository": "git+https://github.com/mrjackyliang/lock-inactive-threads.git",
    "bugs": "https://github.com/mrjackyliang/lock-inactive-threads/issues",
    "license": "https://github.com/mrjackyliang/lock-inactive-threads/blob/HEAD/LICENSE",
    "logo": "https://mrjackyliang.github.io/lock-inactive-threads/images/logo.svg",
    "documentation": "https://mrjackyliang.github.io/lock-inactive-threads/",
    "fundSources": [
      "https://github.com/sponsors/mrjackyliang",
      "https://liang.nyc/paypal"
    ]
  },
  "workspaces": {
    "./": {
      "role": "project",
      "policy": "freezable",
      "name": "lock-inactive-threads-project"
    },
    "./apps/docs": {
      "role": "docs",
      "policy": "freezable",
      "name": "lock-inactive-threads-docs"
    },
    "./packages/lock-inactive-threads": {
      "role": "package",
      "policy": "distributable",
      "name": "lock-inactive-threads"
    }
  },
  "gitignore": {
    "projectExcludes": [
      "graphify-out/"
    ]
  },
  "agents": [
