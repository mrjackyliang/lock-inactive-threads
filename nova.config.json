  "environment": {
    "project": {
      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_"
      },
      "./apps/docs": {
        "prefix": "DOCS_"
      },
      "./packages/lock-inactive-threads": {
        "prefix": "LIT_",
        "variables": [
          {
            "key": "ACTIONS_RUNNER_DEBUG",
            "reach": "local",
            "defaultValue": "false"
          },
          {
            "key": "ACTIONS_STEP_DEBUG",
            "reach": "local",
            "defaultValue": "false"
          },
          {
            "key": "INPUT_GITHUB_TOKEN",
            "reach": "local",
            "defaultValue": ""
          },
          {
            "key": "INPUT_ISSUE_COMMENT",
            "reach": "local",
            "defaultValue": "Due to inactivity, this issue will be locked and marked as resolved. If you have any further questions or inquiries, please feel free to open a new issue."
          },
          {
            "key": "INPUT_ISSUE_INACTIVE_DAYS",
            "reach": "local",
            "defaultValue": "30"
          },
          {
            "key": "INPUT_ISSUE_LOCK_REASON",
            "reach": "local",
            "defaultValue": "resolved"
          },
          {
            "key": "INPUT_PR_COMMENT",
            "reach": "local",
            "defaultValue": "Due to inactivity, this pull request will be locked and marked as resolved. If you have any further questions or inquiries, please feel free to open a new pull request."
          },
          {
            "key": "INPUT_PR_INACTIVE_DAYS",
            "reach": "local",
            "defaultValue": "30"
          },
          {
            "key": "INPUT_PR_LOCK_REASON",
            "reach": "local",
            "defaultValue": "resolved"
          },
          {
            "key": "INPUT_EXCLUDE_LABELS",
            "reach": "local",
            "defaultValue": ""
          },
          {
            "key": "INPUT_LOG_OUTPUT",
            "reach": "local",
            "defaultValue": "true"
          },
          {
            "key": "INPUT_DRY_RUN",
            "reach": "local",
            "defaultValue": "false"
          }
        ]
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGS_"
      }
    }
  },
  "settings": {
    "lockStepVersioning": true,
    "versionStrategy": "semver"
