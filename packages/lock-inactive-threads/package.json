{
  "name": "lock-inactive-threads",
  "version": "1.0.6",
  "description": "A GitHub Action designed to lock issues and pull requests that have been inactive for a configurable number of days",
  "keywords": [
    "actions",
    "github-actions",
    "lock-threads",
    "inactive-issues",
    "stale"
  ],
  "license": "MIT",
  "homepage": "https://mrjackyliang.github.io/lock-inactive-threads/",
  "bugs": {
    "email": "bugs@mrjackyliang.com",
    "url": "https://github.com/mrjackyliang/lock-inactive-threads/issues"
  },
  "author": {
    "name": "Jacky Liang",
    "email": "hello@mrjackyliang.com",
    "url": "https://www.mrjackyliang.com/"
  },
  "funding": [
    "https://github.com/sponsors/mrjackyliang",
    "https://liang.nyc/paypal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrjackyliang/lock-inactive-threads.git",
    "directory": "packages/lock-inactive-threads"
  },
  "exports": {
    ".": {
      "default": "./build/index.js",
      "require": "./build/index.js"
    }
  },
  "main": "./build/index.js",
  "type": "module",
  "files": [
    "./build"
  ],
  "private": false,
  "scripts": {
    "check": "nova utility run-scripts --sequential 'check:*'",
    "check:lint": "eslint ./ --max-warnings=0",
    "check:types-app": "nova utility type-check --project tsconfig.json",
    "check:types-config": "nova utility type-check --project tsconfig.config.json",
    "check:types-tests": "nova utility type-check --project tsconfig.tests.json",
    "check:test": "vitest run",
    "build": "nova utility run-scripts --sequential 'build:*'",
    "build:reset": "shx rm -rf ./build",
    "build:ncc": "npx ncc build src/index.ts -o build --source-map --license licenses.txt",
    "start": "local-action run . src/index.ts .env",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "dependencies": {
    "@actions/core": "1.10.1",
    "@actions/github": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cbnventures/nova": "0.27.1",
    "@github/local-action": "1.5.1",
    "@types/node": "24.9.1",
    "@vercel/ncc": "0.38.1",
    "eslint": "9.39.5",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
